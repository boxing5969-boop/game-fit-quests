# 마이복서153 — 프런트엔드 환경 변수 (Vite 는 VITE_ 접두사 필수)
# 실제 값은 Supabase Dashboard → Project Settings → API 에서 복사
# 파일명은 `.env` (또는 `.env.local`) 로 저장 — git 추적 금지

# Supabase 프로젝트 식별자 (URL slug)
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Supabase Publishable (anon) Key — 클라이언트 노출 OK, RLS 로 보호
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Supabase 프로젝트 URL
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# ----------------------------------------------------------------------
# Edge Functions 시크릿 (Supabase Dashboard → Edge Functions → Secrets)
# 로컬 개발용은 supabase/functions/.env 또는 `supabase secrets set` 사용
# ----------------------------------------------------------------------
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# SAMBANOVA_API_KEY=
# DEEPSEEK_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=     # 서버 사이드 (Edge Function) 만 사용
