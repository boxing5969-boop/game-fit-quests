        </div>

        {/* Sparkle */}
        <div className="absolute -top-1 -right-1 animate-emote-sparkle">
          <svg width="14" height="14" viewBox="0 0 14 14">
            <path d="M7 0 L8.2 5.8 L14 7 L8.2 8.2 L7 14 L5.8 8.2 L0 7 L5.8 5.8Z" fill="white" opacity="0.55" />
          </svg>
