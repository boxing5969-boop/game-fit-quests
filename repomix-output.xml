@import url('https://fonts.googleapis.com/css2?family=Black+Han+Sans&family=Noto+Sans+KR:wght@400;500;700;900&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --background: 220 20% 97%;
    --foreground: 220 30% 12%;

    --card: 0 0% 100%;
    --card-foreground: 220 30% 12%;

    --popover: 0 0% 100%;
    --popover-foreground: 220 30% 12%;

    --primary: 14 90% 55%;
    --primary-foreground: 0 0% 100%;

    --secondary: 220 15% 93%;
    --secondary-foreground: 220 30% 25%;

    --muted: 220 15% 93%;
    --muted-foreground: 220 10% 46%;

    --accent: 45 100% 52%;
    --accent-foreground: 220 30% 12%;

    --destructive: 0 72% 51%;
    --destructive-foreground: 0 0% 100%;

    --border: 220 15% 88%;
    --input: 220 15% 88%;
    --ring: 14 90% 55%;

    --radius: 1rem;

    /* Rank colors */
    --rank-white: 220 10% 70%;
    --rank-blue: 215 90% 55%;
    --rank-red: 0 80% 55%;
    --rank-black: 0 0% 15%;

    /* Quest status */
    --status-locked: 220 10% 65%;
    --status-active: 14 90% 55%;
    --status-pending: 35 95% 55%;
    --status-complete: 150 70% 42%;

    /* XP */
    --xp-bar: 14 90% 55%;
    --xp-bar-bg: 220 15% 90%;

    /* Glow */
    --glow-primary: 0 0 24px hsl(14 90% 55% / 0.25);
    --glow-gold: 0 0 24px hsl(45 100% 52% / 0.25);

    --sidebar-background: 0 0% 100%;
    --sidebar-foreground: 220 30% 25%;
    --sidebar-primary: 14 90% 55%;
    --sidebar-primary-foreground: 0 0% 100%;
    --sidebar-accent: 220 15% 93%;
    --sidebar-accent-foreground: 220 30% 25%;
    --sidebar-border: 220 15% 88%;
    --sidebar-ring: 14 90% 55%;
  }
}

@layer base {
  * {
    @apply border-border;
  }

  body {
    @apply bg-background text-foreground font-body;
    -webkit-tap-highlight-color: transparent;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3, h4, h5, h6 {
    @apply font-display font-bold;
  }
}

@layer utilities {
  .glow-primary {
    box-shadow: var(--glow-primary);
  }
  .glow-gold {
    box-shadow: var(--glow-gold);
  }
  .text-gradient-fire {
    background: linear-gradient(135deg, hsl(14 90% 55%), hsl(45 100% 52%));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .safe-area-bottom {
    padding-bottom: env(safe-area-inset-bottom);
  }
  .animate-bounce-in {
    animation: bounce-in 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .animate-slide-up {
    animation: slide-up 0.35s ease-out both;
  }
  .animate-fade-in {
    animation: fade-in 0.3s ease-out both;
  }
  .animate-scale-in {
    animation: scale-in 0.25s ease-out both;
  }
  .animate-shimmer {
    animation: shimmer 2s infinite;
  }
}

@keyframes bounce-in {
  0% { transform: scale(0.3); opacity: 0; }
  50% { transform: scale(1.05); }
  70% { transform: scale(0.95); }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes slide-up {
  from { transform: translateY(16px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes scale-in {
  from { transform: scale(0.9); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

@keyframes pulse-glow {
  0%, 100% { box-shadow: 0 0 8px hsl(14 90% 55% / 0.3); }
  50% { box-shadow: 0 0 20px hsl(14 90% 55% / 0.5); }
}

.scrollbar-hide {
  -ms-overflow-style: none;
  scrollbar-width: none;
}
.scrollbar-hide::-webkit-scrollbar {
  display: none;
}

/* ?먥븧??Emoticon Boxer Animations ?먥븧??*/
@keyframes emote-enter {
  0% { opacity: 0; transform: scale(0.3) translateY(30px); }
  50% { opacity: 1; transform: scale(1.12) translateY(-6px); }
  70% { transform: scale(0.95) translateY(2px); }
  100% { transform: scale(1) translateY(0); }
}
@keyframes emote-exit {
  0% { opacity: 1; transform: scale(1); }
  100% { opacity: 0; transform: scale(0.4) translateY(20px); }
}
@keyframes emote-idle {
  0%, 100% { transform: translateY(0) rotate(0deg) scale(1); }
  20% { transform: translateY(-4px) rotate(-1deg) scale(1.01); }
  40% { transform: translateY(-6px) rotate(0.5deg) scale(1); }
  60% { transform: translateY(-3px) rotate(1deg) scale(0.99); }
  80% { transform: translateY(-5px) rotate(-0.5deg) scale(1.01); }
}
@keyframes emote-punch {
  0% { transform: translateX(0) scaleX(1) scaleY(1) rotate(0deg); }
  10% { transform: translateX(0) scaleX(0.92) scaleY(1.05) rotate(-2deg); }
  22% { transform: translateX(10px) scaleX(1.08) scaleY(0.96) rotate(3deg); }
  32% { transform: translateX(2px) scaleX(1) scaleY(1) rotate(0deg); }
  42% { transform: translateX(0) scaleX(0.94) scaleY(1.04) rotate(2deg); }
  55% { transform: translateX(-10px) scaleX(1.08) scaleY(0.96) rotate(-3deg); }
  68% { transform: translateX(-2px) scaleX(1) scaleY(1) rotate(0deg); }
  80% { transform: translateX(0) scaleX(0.97) scaleY(1.02) rotate(0deg); }
  100% { transform: translateX(0) scaleX(1) scaleY(1) rotate(0deg); }
}
@keyframes emote-glow {
  0%, 100% { opacity: 0.3; transform: scale(0.7); }
  50% { opacity: 0.55; transform: scale(0.75); }
}
@keyframes emote-speed-line {
  0% { opacity: 0; transform: translateX(-8px); }
  30% { opacity: 0.8; transform: translateX(4px); }
  100% { opacity: 0; transform: translateX(12px); }
}
@keyframes emote-speed-line-r {
  0% { opacity: 0; transform: translateX(8px); }
  30% { opacity: 0.8; transform: translateX(-4px); }
  100% { opacity: 0; transform: translateX(-12px); }
}
@keyframes emote-sparkle {
  0%, 100% { opacity: 0.3; transform: scale(0.8) rotate(0deg); }
  50% { opacity: 0.8; transform: scale(1.1) rotate(45deg); }
}

.animate-emote-enter { animation: emote-enter 0.7s cubic-bezier(0.34,1.56,0.64,1) forwards; }
.animate-emote-exit { animation: emote-exit 0.4s ease-in forwards; }
.animate-emote-idle { animation: emote-idle 2.5s ease-in-out infinite; }
.animate-emote-punch { animation: emote-punch 0.7s ease-in-out; }
.animate-emote-glow { animation: emote-glow 3s ease-in-out infinite; }
.animate-emote-speed-line { animation: emote-speed-line 0.35s ease-out forwards; }
.animate-emote-speed-line-r { animation: emote-speed-line-r 0.35s ease-out 0.15s forwards; }
.animate-emote-sparkle { animation: emote-sparkle 2.5s ease-in-out infinite; }


/* ══ Aura System v2 ══ */

/* ── 기본 ── */
@keyframes aura-pulse-slow {
  0%, 100% { opacity: 0.5; transform: scale(1); }
  50%       { opacity: 0.8; transform: scale(1.04); }
}

/* ── 중급 ── */
@keyframes aura-pulse-fast {
  0%, 100% { opacity: 0.7; transform: scale(1); }
  50%       { opacity: 1;   transform: scale(1.07); }
}

/* ── 번개 ── */
@keyframes aura-flicker {
  0%, 100% { opacity: 1; }
  20%       { opacity: 0.15; }
  40%       { opacity: 0.95; }
  60%       { opacity: 0.1; }
  80%       { opacity: 0.9; }
}

/* ── 스핀 ── */
@keyframes aura-spin-slow {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}
@keyframes aura-spin-reverse {
  from { transform: rotate(360deg); }
  to   { transform: rotate(0deg); }
}

/* ── 블랙/전설: 반짝임 파티클 ── */
@keyframes aura-sparkle {
  0%, 100% { opacity: 0; transform: scale(0) rotate(0deg); }
  50%       { opacity: 1; transform: scale(1) rotate(180deg); }
}
@keyframes aura-sparkle-delayed {
  0%, 30%, 100% { opacity: 0; transform: scale(0); }
  60%            { opacity: 1; transform: scale(1.2); }
}

/* ── 전설: 홀로그램 색상 변환 ── */
@keyframes aura-holo {
  0%   { filter: hue-rotate(0deg)   brightness(1.2); }
  50%  { filter: hue-rotate(180deg) brightness(1.6); }
  100% { filter: hue-rotate(360deg) brightness(1.2); }
}

/* ── 블랙: 어두운 파동 ── */
@keyframes aura-dark-wave {
  0%, 100% { opacity: 0.9; transform: scale(1);    filter: brightness(0.8); }
  50%       { opacity: 0.5; transform: scale(1.08); filter: brightness(1.3); }
}

/* ?? Frame ring animation keyframes ?? */
@keyframes flicker {
  0%, 100% { opacity: 1; }
  45%, 55%  { opacity: 0.6; }
}
@keyframes breathe {
  0%, 100% { opacity: 0.75; }
  50%       { opacity: 1; }
}
@keyframes sparkle {
  0%, 100% { opacity: 0.7; transform: scale(1); }
  50%       { opacity: 1; transform: scale(1.04); }
}
@keyframes galaxy-spin {
  0%   { filter: hue-rotate(0deg); }
  100% { filter: hue-rotate(360deg); }
}

/* ?? LayeredCharacterRenderer global animations ?? */
@keyframes char-idle-bob {
  0%, 100% { transform: translateY(0px); }
  50%       { transform: translateY(-2px); }
}
@keyframes char-blink {
  0%, 88%, 100% { transform: scaleY(1); }
  93%           { transform: scaleY(0.07); }
}
@keyframes char-shadow-pulse {
  0%, 100% { opacity: 1; transform: scaleX(1); }
  50%       { opacity: 0.7; transform: scaleX(0.88); }
}
.animate-char-idle    { animation: char-idle-bob 2.8s ease-in-out infinite; }
.animate-char-blink   { animation: char-blink 4.5s ease-in-out infinite; transform-origin: center; }
.animate-char-shadow  { animation: char-shadow-pulse 2.8s ease-in-out infinite; }

@media (prefers-reduced-motion: reduce) {
  .animate-emote-enter,
  .animate-emote-exit,
  .animate-emote-idle,
  .animate-emote-punch,
  .animate-emote-glow,
  .animate-emote-speed-line,
  .animate-emote-speed-line-r,
  .animate-emote-sparkle { animation: none; }
}
