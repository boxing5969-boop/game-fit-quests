        stroke={config.fill} strokeWidth={w} fill="none" strokeLinecap="round"
      />
      <path
        d={angry ? `M112 ${y+1} Q122 ${y-4} 130 ${y+3}` : arched ? `M112 ${y+1} Q121 ${y-5} 130 ${y}` : `M112 ${y+1} Q121 ${y-2} 130 ${y+1}`}
        stroke={config.fill} strokeWidth={w} fill="none" strokeLinecap="round"
      />
    </g>
