              <div className="absolute top-1/4 -left-3 animate-emote-speed-line-r">
                <svg width="22" height="8" viewBox="0 0 22 8">
                  <line x1="22" y1="4" x2="6" y2="4" stroke="white" strokeWidth="2" strokeLinecap="round" opacity="0.65" />
                </svg>
