                className="flex w-full items-center justify-between rounded-lg border border-border bg-background px-3 py-1.5 text-xs text-muted-foreground active:scale-[0.98]"
              >
                <span>{commentMap[item.id] || "💬 코멘트 선택/입력..."}</span>
