AS $$
  SELECT EXISTS (
    SELECT 1
    FROM profiles p1
    JOIN profiles p2 ON p1.branch_name = p2.branch_name
    WHERE p1.user_id = auth.uid()
      AND p2.user_id = _user_id
      AND EXISTS (
        SELECT 1 FROM user_roles
        WHERE user_id = auth.uid() AND role IN ('branch_manager', 'super_admin')
      )
  )
$$;

