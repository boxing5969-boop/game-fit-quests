          <div className="rounded-xl bg-card border border-border p-3">
            <p className="text-xs font-bold text-muted-foreground mb-2">만료 시간 설정</p>
            <div className="flex gap-2">
              {[
                { label: "30초", value: 30 },
                { label: "1분", value: 60 },
                { label: "5분", value: 300 },
                { label: "10분", value: 600 },
