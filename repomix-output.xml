  size?: number;
  className?: string;
  animate?: boolean;
}

function cfg(parts: PartsSelection, cat: string): Record<string, any> | null {
  const key = parts[cat];
  if (!key) return null;
  return getPartByKey(key)?.config ?? null;
}

