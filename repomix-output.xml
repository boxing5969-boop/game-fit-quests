              <div>
                <p className="text-lg font-bold text-rank-blue">{s.avg_level}</p>
                <p className="text-[9px] text-muted-foreground">평균 Lv</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  );
};

