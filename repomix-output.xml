  skin: SKIN_PARTS,
  hair_back: HAIR_BACK_PARTS,
  hair_front: HAIR_FRONT_PARTS,
  eyebrows: EYEBROW_PARTS,
  eyes: EYE_PARTS,
  mouth: MOUTH_PARTS,
  gloves: GLOVE_PARTS,
  top: TOP_PARTS,
  shorts: SHORTS_PARTS,
  shoes: SHOE_PARTS,
  accessory: ACCESSORY_PARTS,
  effect: EFFECT_PARTS,
};

