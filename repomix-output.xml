  StatCard,
} from "@/components/shared/BadgeGrid";

const MyPage = () => {
  const navigate = useNavigate();
  const { profile, progress, role, signOut } = useAuth();
  const { data: xpLogs } = useXpLogs(30);
  const { data: allBadges, isLoading: badgesLoading } = useBadges();
